<Window x:Class="KinectRedMarker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect Red Marker" Height="720" Width="1280">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- View Camera -->
        <Image Name="cameraView" Grid.Column="0" Stretch="Uniform"/>

        <!-- Panel hiển thị thông tin -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock x:Name="DistanceText" FontSize="18" Margin="0,10" Foreground="Black"/>
            <TextBlock x:Name="RedMarkerText" FontSize="16" Margin="0,20" Foreground="Red"/>
            <TextBlock x:Name="GreenMarkerText" FontSize="16" Margin="0,20" Foreground="Green"/>
        </StackPanel>
    </Grid>
</Window>
